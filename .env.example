# ==============================================================================
# REAL MINI TOWNSHIP AUTOPILOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & GENERATION ENGINES
# ------------------------------------------------------------------------------
# Google Gemini 2.5 Flash Free API Key (Get at https://aistudio.google.com)
GEMINI_API_KEY=

# HuggingFace Access Token for FLUX.1-dev and Wan2.1 / LTX-Video Spaces
# (Get free token at https://huggingface.co/settings/tokens)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 2. YOUTUBE SHORTS UPLOADER (YouTube Data API v3)
# ------------------------------------------------------------------------------
# Create project on Google Cloud Console -> Enable YouTube Data API v3 -> OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Video privacy setting: public | unlisted | private (default: public)
YOUTUBE_PRIVACY=public

# ------------------------------------------------------------------------------
# 3. INSTAGRAM REELS UPLOADER (Instagram Graph API)
# ------------------------------------------------------------------------------
# Meta Developer Portal -> App with Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 4. FACEBOOK REELS UPLOADER (Facebook Graph API)
# ------------------------------------------------------------------------------
# Facebook Page Access Token & Page ID
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ------------------------------------------------------------------------------
# 5. EXECUTION FLAGS
# ------------------------------------------------------------------------------
# Set to 'true' to generate videos locally without dispatching uploads
DRY_RUN=false

# Override default town series: mountain_village | smart_city | desert_town
TOWN_KEY=smart_city
